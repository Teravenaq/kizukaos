<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg xmlns="http://www.w3.org/2000/svg" width="640" height="480" version="1.1">
  <rect width="640" height="480" fill="#0d1b2a"/>
  <rect x="0" y="0" width="640" height="8" fill="#f97316"/>
  <rect x="0" y="472" width="640" height="8" fill="#f97316"/>
  <text x="320" y="185" font-family="monospace" font-size="64" font-weight="bold"
        fill="#ffffff" text-anchor="middle">KizukaOS</text>
  <text x="320" y="235" font-family="monospace" font-size="22" fill="#f97316"
        text-anchor="middle">live · fast · yours</text>
  <text x="320" y="300" font-family="monospace" font-size="14" fill="#8899aa"
        text-anchor="middle">@ARCHITECTURE@ · kernel @LINUX_VERSIONS@</text>
  <text x="320" y="325" font-family="monospace" font-size="14" fill="#8899aa"
        text-anchor="middle">build @MONTH@/@DAY@/@YEAR@ @HOUR@:@MINUTE@</text>
  <text x="320" y="440" font-family="monospace" font-size="13" fill="#667788"
        text-anchor="middle">Press ENTER to boot the live system</text>
</svg>