#!/bin/sh
# Runs on host at binary stage start (before binary_syslinux which invokes `rsvg` inside chroot).
# librsvg2-bin gets installed by Check_package during binary_syslinux, AFTER hooks... so instead:
# pre-create the shim now; rsvg-convert will exist by the time it's invoked because Check_package
# installs librsvg2-bin in the same step before rendering. Symlink target may be dangling now - fine.
set -e
ln -sf /usr/bin/rsvg-convert chroot/usr/local/bin/rsvg 2>/dev/null || {
    mkdir -p chroot/usr/local/bin
    ln -sf /usr/bin/rsvg-convert chroot/usr/local/bin/rsvg
}
echo "KizukaOS: rsvg shim created in chroot"
