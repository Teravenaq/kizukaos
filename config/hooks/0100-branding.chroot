#!/bin/sh
# Branding KizukaOS: hostname, motd, neofetch alias, wallpaper
set -e
echo "kizukaos" > /etc/hostname
cat > /etc/motd <<'EOF'

  ██  ██  ██     ██     ████████
  ██  ██  ██     ██     ██
  ██  ██  ██     ██     ███████
  ██  ██  ██     ██     ██
   ████   ██████ ██████ ████████

  KizukaOS — build by Kizuka (Putra)
  Selamat datang! ⚡
EOF
echo "alias fetch='neofetch'" >> /etc/skel/.bashrc
echo "PS1='\u@kizukaos:\w\$ '" >> /etc/skel/.bashrc

# Wallpaper KizukaOS untuk semua user baru
mkdir -p /usr/share/backgrounds
cat > /usr/share/backgrounds/kizukaos-wallpaper.xml <<'WALL'
