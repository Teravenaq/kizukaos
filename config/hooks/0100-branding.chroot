WALL
base64 -d /usr/share/backgrounds/kizukaos-wallpaper.xml > /usr/share/backgrounds/kizukaos.png
for U in /etc/skel /root; do
  mkdir -p $U/.config/xfce4/xfconf/xfce-perchannel-xml
  cat > $U/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="uint" value="0"/>
          <property name="image-style" type="uint" value="5"/>
          <property name="last-style" type="uint" value="5"/>
          <property name="image-show" type="bool" value="true"/>
          <property name="image-path" type="string" value="/usr/share/backgrounds/kizukaos.png"/>
        </property>
      </property>
    </property>
  </property>
</channel>
XML
done

# Wallpaper: autostart script (set ke semua monitor, hindari masalah nama monitor)
cat > /usr/local/bin/kizukaos-wallpaper <<'WPSH'
#!/bin/sh
# Set wallpaper KizukaOS di semua monitor/workspace sesi XFCE saat ini.
command -v xfconf-query >/dev/null 2>&1 || exit 0
WALL=/usr/share/backgrounds/kizukaos.png
[ -f "$WALL" ] || exit 0
for attempt in 1 2 3 4 5; do
    PROPS=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'image-path$')
    if [ -n "$PROPS" ]; then
        echo "$PROPS" | while read -r p; do
            xfconf-query -c xfce4-desktop -p "$p" -s "$WALL" 2>/dev/null
        done
        for suf in image-show; do
            xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E "${suf}$" | while read -r p; do
                xfconf-query -c xfce4-desktop -p "$p" -s true 2>/dev/null
            done
        done
        xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'image-style$' | while read -r p; do
            xfconf-query -c xfce4-desktop -p "$p" -s 5 2>/dev/null
        done
        # fallback: kalau belum ada properti image-path sama sekali, set untuk monitor0
        if [ -z "$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'image-path$')" ]; then
            for m in monitor0 monitorQXL-1 monitorVirtual-1; do
                for w in workspace0 workspace1; do
                    xfconf-query -c xfce4-desktop -p "/backdrop/screen0/${m}/${w}/image-path" -s "$WALL" -n -t string 2>/dev/null
                done
            done
        fi
        sleep 1
        exit 0
    fi
    sleep 2
done
exit 0

WPSH
chmod +x /usr/local/bin/kizukaos-wallpaper
mkdir -p /etc/xdg/autostart
cat > /etc/xdg/autostart/kizukaos-wallpaper.desktop <<'WPDESK'
[Desktop Entry]
Type=Application
Name=KizukaOS Wallpaper
Comment=Set KizukaOS wallpaper on all monitors
Exec=/usr/local/bin/kizukaos-wallpaper
Terminal=false
OnlyShowIn=XFCE;

WPDESK
echo "wallpaper autostart installed"
echo "branding v0.4 applied"
