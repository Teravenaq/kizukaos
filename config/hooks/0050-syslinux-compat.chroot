#!/bin/sh
# Compat shims for live-build 3.0 (Debian-era) on Ubuntu 24.04 noble:
# 1. gfxboot-theme-ubuntu bootlogo gone -> dummy empty tar so `tar xfz` succeeds.
# 2. old syslinux paths: isolinux.bin + vesamenu.c32 symlinks.
# 3. `rsvg` command gone -> wrapper translating old CLI (in out) to rsvg-convert (-o).
set -e
mkdir -p /usr/share/gfxboot-theme-ubuntu
if [ ! -s /usr/share/gfxboot-theme-ubuntu/bootlogo.tar.gz ]; then
    T=$(mktemp -d)
    mkdir -p "$T/empty"
    tar cfz /usr/share/gfxboot-theme-ubuntu/bootlogo.tar.gz -C "$T" empty
    rm -rf "$T"
fi
mkdir -p /usr/lib/syslinux
if [ -e /usr/lib/ISOLINUX/isolinux.bin ]; then
    ln -sf /usr/lib/ISOLINUX/isolinux.bin /usr/lib/syslinux/isolinux.bin
fi
if [ -e /usr/lib/syslinux/modules/bios/vesamenu.c32 ]; then
    ln -sf /usr/lib/syslinux/modules/bios/vesamenu.c32 /usr/lib/syslinux/vesamenu.c32
fi
if [ -e /usr/bin/rsvg-convert ]; then
    cat > /usr/local/bin/rsvg <<'RSVG'
#!/bin/sh
# translate `rsvg --format png --height H --width W in.svg out.png` to rsvg-convert
in=""
out=""
while [ $# -gt 0 ]; do
    case "$1" in
        --format|--height|--width) fmt="$1"; shift; val="$1"; shift; ;;
        *) if [ -z "$in" ]; then in="$1"; else out="$1"; fi; shift; ;;
    esac
done
exec /usr/bin/rsvg-convert -f png -w 640 -h 480 "$in" -o "$out"
RSVG
    chmod +x /usr/local/bin/rsvg
fi
echo "KizukaOS: gfxboot dummy + syslinux compat + rsvg wrapper done"
